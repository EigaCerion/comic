<?xml version="1.0" encoding="utf-8"?>
<!--
  fitsSystemWindows ditambahkan sendiri, tidak ada di cetakan Capacitor.

  Android 15 ke atas memaksa aplikasi bertarget SDK 35+ menggambar tepi-ke-tepi:
  jendela dibentangkan sampai ke belakang status bar dan bilah navigasi. Cara
  lama Capacitor menggeser konten (StatusBar.setOverlaysWebView(false)) memakai
  bendera System UI yang sudah tidak digubris versi itu, jadi TopBar aplikasi
  berakhir tertimpa jam dan ikon HP — persis yang terlihat di layar pertama.

  Dengan bendera ini WebView menerima inset sistem sebagai padding, dan begitu
  reader menyembunyikan status bar insetnya mengecil sendiri jadi nol sehingga
  halaman komik tetap memakai seluruh tinggi layar. Dipasang di dua tempat
  karena CoordinatorLayout hanya meneruskan inset ke anak yang memintanya.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <WebView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
