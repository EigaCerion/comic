<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Warna latar jendela. Terlihat sebagai jalur tipis di belakang status bar dan
      bilah navigasi, yaitu bagian yang tidak lagi ditempati isi web sejak
      MainActivity memasang inset sistem sebagai padding WebView.

      Diambil dari latar gelap aplikasi (night di styles/theme.css) karena tema
      bawaan aplikasi memang gelap (uiSlice: theme ?? 'dark'). Tanpa ini yang
      muncul adalah latar putih bawaan Theme.AppCompat, dan hasilnya pita putih
      menyala di atas aplikasi gelap setiap kali aplikasi dibuka.

      Nilai yang sama ditulis di dua tempat lain dengan alasan berbeda, dan
      ketiganya harus bergerak bersama: capacitor.config.json (backgroundColor —
      yang menutup jalur padding itu sendiri, karena di sana yang tampak adalah
      latar WebView, bukan latar jendela) dan meta theme-color di index.html.
    -->
    <color name="latarNaruReader">#0f1419</color>
</resources>
