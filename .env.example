# ── API ────────────────────────────────────────────────────────────────
# API_PORT dibaca lebih dulu daripada PORT — pakai ini kalau task runner /
# tooling lain sudah menyuntik PORT untuk dev server frontend.
API_PORT=3000
PORT=3000
NODE_ENV=development

# Lokasi data lokal. Relatif terhadap apps/api, atau pakai absolute path
# (mis. D:/NaruReaderData) kalau komik disimpan di drive lain.
DATA_DIR=./data

# Folder sumber import (folder komik / file .cbz). Ini satu-satunya lokasi di
# luar DATA_DIR yang boleh dibaca API — jangan arahkan ke root disk.
IMPORT_DIR=./import

# ── Kompresi gambar (Sharp) ───────────────────────────────────────────
# Target: HD quality, ukuran file 70-80% lebih kecil
IMAGE_FORMAT=webp
IMAGE_QUALITY=75
IMAGE_MAX_WIDTH=1600
IMAGE_MAX_HEIGHT=2560
COMPRESSION_CONCURRENCY=4

# Knob CPU. Diukur lewat `npm run bench:compress`: pada halaman uji, effort 6
# hanya menghemat 0,5pp dan grayscale 0,2pp, tapi keduanya ~2x lebih lambat.
# Default dibiarkan murah; ukur sendiri dengan halaman aslimu sebelum menaikkan.
IMAGE_EFFORT=4
IMAGE_AUTO_GRAYSCALE=false

# Gambar yang sudah WebP, sudah di bawah batas resolusi, dan sudah efisien
# (byte/pixel rendah) disimpan apa adanya: 0 CPU, 0 kehilangan kualitas.
IMAGE_PASSTHROUGH=true
IMAGE_PASSTHROUGH_BPP=0.35

# ── Download worker ───────────────────────────────────────────────────
WORKER_ENABLED=true

# Bot importir: berapa job chapter yang dikerjakan bersamaan.
# Kecepatan sebenarnya tetap dibatasi IMAGE_CONCURRENCY per host, jadi menaikkan
# angka ini membantu saat mengimpor dari beberapa situs sekaligus.
IMPORTER_WORKERS=5

# Bot pengawas: memeriksa kelengkapan hasil import (berkas ada, tidak kosong,
# jumlah halaman cocok) dan mengantre ulang yang cacat.
SUPERVISOR_WORKERS=3
SUPERVISOR_SWEEP_MS=300000

DOWNLOAD_CONCURRENCY=2
DOWNLOAD_MAX_ATTEMPTS=3

# Batas waktu MENUNGGU RESPONS (koneksi + header). Bukan batas lama unduhan:
# satu halaman bisa berukuran 7,5 MB dan butuh 20+ detik walau koneksi sehat.
DOWNLOAD_TIMEOUT=30000

# Batas "mandek": lama maksimum TANPA data masuk. Selama byte masih mengalir,
# unduhan sebesar apa pun dibiarkan selesai. Ini yang dulu salah — batas total
# 30 detik membuang chapter yang sudah 99% selesai hanya karena satu halaman besar.
DOWNLOAD_STALL_TIMEOUT=20000

# Pengaman memori: berkas di atas ini ditolak, bukan ditelan.
IMAGE_MAX_BYTES=50331648

# Percobaan ulang per GAMBAR (bukan per chapter). Satu gangguan sesaat tidak
# boleh menggagalkan chapter yang halaman lainnya sudah terunduh.
IMAGE_RETRY=3

# Sopan-santun terhadap server sumber: jeda minimum antar request ke host yang
# sama, dan kepatuhan robots.txt. Turunkan delay = risiko diblokir naik.
REQUEST_DELAY_MS=750
RESPECT_ROBOTS=true
USER_AGENT=NaruReader/0.1 (+local personal library)

# Gambar jumlahnya ratusan, jadi punya jatah sendiri: jeda lebih pendek dan
# boleh paralel. Ini pengungkit throughput terbesar — bukan setelan kompresi.
IMAGE_REQUEST_DELAY_MS=150
IMAGE_CONCURRENCY=4

# Poster & halaman komik hampir selalu dilayani CDN dengan domain berbeda
# (mis. thumbnail.<situs>.to). Kalau halaman sumbernya sudah lolos allowlist,
# gambar yang dirujuknya ikut diizinkan. Penjagaan localhost/IP privat tetap ada.
ALLOW_REFERENCED_IMAGE_HOSTS=true
# Domain yang boleh jadi sumber download (dipisah koma). Kosongkan HANYA
# kalau paham risikonya — nilai ini adalah allowlist anti-SSRF.
ALLOWED_SOURCE_DOMAINS=komiku.org,komikpedia.net,webtoons.com,siikomik.net,ngomik.cc,komikindo.ch,kiryuu.to

# ── Akun super admin awal ─────────────────────────────────────────────
# WAJIB diisi saat pertama kali menjalankan, kalau tidak tidak ada satu pun akun
# yang bisa mengelola pengguna. Dipakai HANYA ketika akun itu belum ada di
# database; setelah akun terbentuk, mengubah nilai di sini tidak akan menimpa
# sandi yang sudah diganti lewat aplikasi.
#
# Membaca komik TIDAK butuh akun sama sekali. Akun hanya diperlukan untuk
# memberi rating, berkomentar, dan mengelola koleksi.
#
# Pilih sandi sendiri — minimal 8 karakter. JANGAN pakai contoh di bawah.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=ganti-sandi-ini-sebelum-dipakai

# ── Nama tetap untuk diakses dari perangkat lain ──────────────────────
# Isi kalau kamu punya nama yang stabil untuk mesin ini, misalnya nama MagicDNS
# dari Tailscale (naruread.tail1234.ts.net) atau entri DNS di router sendiri
# (naruread.lan). Aplikasi TIDAK menyiarkan apa pun — ia hanya memakai nama ini
# untuk QR dan halaman Pengaturan, menggantikan IP yang berubah tiap pindah
# jaringan. Kosongkan kalau belum punya.
NAMA_HOST=

# ── Penyiaran nama di jaringan lokal (mDNS) ───────────────────────────
# Default MATI. Menyalakannya membuat aplikasi mengumumkan diri ke semua
# perangkat di jaringan, sementara dukungan `.local` tidak merata (Android
# sering gagal). Nyalakan hanya di jaringan tepercaya.
MDNS_ENABLED=false
MDNS_HOST=naruread.local

# ── Frontend (apps/web) ───────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
